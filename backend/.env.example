# ─── Application ─────────────────────────────────────
APP_NAME=HarvestAI
APP_ENV=development
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────
# Local dev (docker compose up):
DATABASE_URL=postgresql+asyncpg://harvestai:harvestai_dev@localhost:5432/harvestai
DATABASE_URL_SYNC=postgresql+psycopg2://harvestai:harvestai_dev@localhost:5432/harvestai

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────────
# Згенерувати: openssl rand -hex 32
JWT_SECRET=change_me_to_random_32_byte_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# ─── CORS ────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Sentinel Hub ────────────────────────────────────
# Реєстрація: https://www.sentinel-hub.com/
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=
SH_MONTHLY_PU_LIMIT=900

# ─── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=600
OPENAI_DAILY_TOKEN_BUDGET=100000

# ─── OpenWeather ─────────────────────────────────────
OPENWEATHER_API_KEY=

# ─── Storage ─────────────────────────────────────────
MODELS_DIR=./models
REPORTS_DIR=./var/reports
RASTERS_DIR=./var/rasters
